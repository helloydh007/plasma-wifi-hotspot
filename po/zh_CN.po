#: plasmoid/contents/ui/FullRepresentation.qml:46
msgid "Hotspot: %1"
msgstr "热点：%1"

#: plasmoid/contents/ui/FullRepresentation.qml:50
msgid "Normal mode (Wi-Fi disconnected, NIC as AP)"
msgstr "普通模式（断开 Wi-Fi，网卡当 AP）"

#: plasmoid/contents/ui/FullRepresentation.qml:51
msgid "Concurrent mode (Wi-Fi stays connected)"
msgstr "并发模式（保持 Wi-Fi 连接）"

#: plasmoid/contents/ui/FullRepresentation.qml:69
msgctxt "@label wifi row"
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: plasmoid/contents/ui/FullRepresentation.qml:76
msgid "Not connected (normal mode occupies the NIC)"
msgstr "未连接（普通模式占用网卡时需断开）"

#: plasmoid/contents/ui/FullRepresentation.qml:77
msgid "Not connected"
msgstr "未连接"

#: plasmoid/contents/ui/FullRepresentation.qml:83
msgid "Hotspot"
msgstr "热点"

#: plasmoid/contents/ui/FullRepresentation.qml:87
#: plasmoid/contents/ui/main.qml:34
msgctxt "The hotspot is switched off"
msgid "Off"
msgstr "已关闭"

#: plasmoid/contents/ui/FullRepresentation.qml:87
msgid "Standby (no beacon)"
msgstr "待命（未发信标）"

#: plasmoid/contents/ui/FullRepresentation.qml:89
#: plasmoid/contents/ui/main.qml:70
msgid "%1 device"
msgid_plural "%1 devices"
msgstr[0] "%1 台设备"

#: plasmoid/contents/ui/FullRepresentation.qml:93
msgid "Autostart"
msgstr "开机自启"

#: plasmoid/contents/ui/FullRepresentation.qml:96
msgid "Disabled"
msgstr "已禁用"

#: plasmoid/contents/ui/FullRepresentation.qml:96
msgid "Enabled"
msgstr "已启用"

#: plasmoid/contents/ui/FullRepresentation.qml:107
msgid ""
"⚠ Normal mode: turning on the hotspot disconnects the current Wi-Fi (uplink "
"then relies on wired network)"
msgstr "⚠ 普通模式：开启热点会断开当前 Wi-Fi 连接（此后设备上网依赖有线网络）"

#: plasmoid/contents/ui/FullRepresentation.qml:116
msgid "Running…"
msgstr "执行中…"

#: plasmoid/contents/ui/FullRepresentation.qml:116
msgid "Turn off hotspot"
msgstr "关闭热点"

#: plasmoid/contents/ui/FullRepresentation.qml:116
msgid "Turn on hotspot"
msgstr "开启热点"

#: plasmoid/contents/ui/FullRepresentation.qml:126
msgid "Hotspot mode"
msgstr "热点模式"

#: plasmoid/contents/ui/FullRepresentation.qml:133
msgid "Concurrent (Wi-Fi stays on, hotspot limited to 2.4GHz same channel)"
msgstr "并发模式（Wi-Fi 不断，热点限 2.4GHz 同信道）"

#: plasmoid/contents/ui/FullRepresentation.qml:141
msgid "Normal (disconnect Wi-Fi, whole NIC as hotspot)"
msgstr "普通模式（断开 Wi-Fi，网卡整体做热点）"

#: plasmoid/contents/ui/FullRepresentation.qml:150
msgid "Autostart hotspot at boot"
msgstr "开机自动启用热点"

#: plasmoid/contents/ui/FullRepresentation.qml:161
msgid "Hotspot name & password"
msgstr "热点名称与密码"

#: plasmoid/contents/ui/FullRepresentation.qml:172
msgid "Current password"
msgstr "当前密码"

#: plasmoid/contents/ui/FullRepresentation.qml:175
msgid "(not set)"
msgstr "（未设置）"

#: plasmoid/contents/ui/FullRepresentation.qml:180
msgid "Hide password"
msgstr "隐藏密码"

#: plasmoid/contents/ui/FullRepresentation.qml:180
msgid "Show password"
msgstr "显示密码"

#: plasmoid/contents/ui/FullRepresentation.qml:190
msgid "Hotspot name (1-32 characters)"
msgstr "热点名称（1-32 字符）"

#: plasmoid/contents/ui/FullRepresentation.qml:199
msgid "New password (8-63 characters, empty = keep password)"
msgstr "新密码（8-63 字符，留空则只改名称）"

#: plasmoid/contents/ui/FullRepresentation.qml:208
msgid "Apply name/password"
msgstr "应用名称/密码"

#: plasmoid/contents/ui/FullRepresentation.qml:222
msgid ""
"When the hotspot is running it restarts automatically to apply the change "
"(connected devices must reconnect)."
msgstr "热点正在运行时，保存后会自动重启热点让新名称/密码生效（已连接的设备需要重连）。"

#: plasmoid/contents/ui/FullRepresentation.qml:235
msgid "Dependencies: all ready ✓"
msgstr "依赖检查：全部就绪 ✓"

#: plasmoid/contents/ui/FullRepresentation.qml:236
msgid "Dependencies: %1 missing ⚠"
msgstr "依赖检查：缺少 %1 项 ⚠"

#: plasmoid/contents/ui/FullRepresentation.qml:240
msgid "Recheck"
msgstr "重新检查"

#: plasmoid/contents/ui/FullRepresentation.qml:268
msgid ""
"Fix commands (one auth prompt; package installs are deliberately not "
"password-free)"
msgstr "修复命令（会弹一次授权框；系统包安装刻意不纳入免密授权）"

#: plasmoid/contents/ui/FullRepresentation.qml:287
msgid "Copy commands"
msgstr "复制上面的命令"

#: plasmoid/contents/ui/FullRepresentation.qml:292
msgid "Commands copied to clipboard"
msgstr "命令已复制到剪贴板"

#: plasmoid/contents/ui/configGeneral.qml:11
msgid "Show band/channel next to the tray icon"
msgstr "在托盘图标旁显示频段/信道"

#: plasmoid/contents/ui/configGeneral.qml:18
msgid "Status refresh interval (seconds)"
msgstr "状态刷新间隔（秒）"

#: plasmoid/contents/ui/configGeneral.qml:23
msgid ""
"Tip: concurrent mode keeps Wi-Fi connected (hotspot on the same 2.4GHz "
"channel); normal mode disconnects Wi-Fi and uses the whole NIC as the "
"hotspot."
msgstr "提示：并发模式保持 Wi-Fi 连接（热点在 2.4GHz 同信道）；普通模式会断开 Wi-Fi，把网卡整体当热点用。"

#: plasmoid/contents/ui/main.qml:34
msgid "Backend unavailable"
msgstr "后端不可用"

#: plasmoid/contents/ui/main.qml:34
msgid "Running"
msgstr "运行中"

#: plasmoid/contents/ui/main.qml:34
msgctxt "Wi-Fi not on 2.4GHz yet, hotspot not beaconing"
msgid "Standby"
msgstr "待命"

#: plasmoid/contents/ui/main.qml:38
msgctxt "Short tray label"
msgid "Off"
msgstr "关"

#: plasmoid/contents/ui/main.qml:67
msgid "Wi-Fi hotspot: %1"
msgstr "Wi-Fi 热点：%1"

#: plasmoid/contents/ui/main.qml:69
msgid "Hotspot %1 %2 ch%3"
msgstr "热点 %1 %2 ch%3"

#: plasmoid/contents/ui/main.qml:72
msgid "Normal mode: enabling will disconnect Wi-Fi"
msgstr "普通模式：开启会断开 Wi-Fi"

#: plasmoid/contents/ui/main.qml:73
msgid "Wi-Fi %1 %2 ch%3"
msgstr "Wi-Fi %1 %2 ch%3"

#: plasmoid/contents/ui/main.qml:73
msgid "Wi-Fi not connected"
msgstr "Wi-Fi 未连接"

#: plasmoid/contents/ui/main.qml:147
msgid "Done"
msgstr "已完成"

#: plasmoid/contents/ui/main.qml:147
msgid "see journalctl -u kde-hotspot"
msgstr "见 journalctl -u kde-hotspot"

#: plasmoid/contents/ui/main.qml:149 plasmoid/contents/ui/main.qml:198
#: plasmoid/contents/ui/main.qml:199 plasmoid/contents/ui/main.qml:201
msgid "Failed: %1"
msgstr "失败：%1"

#: plasmoid/contents/ui/main.qml:185
msgid "Running: %1"
msgstr "执行中：%1"

#: plasmoid/contents/ui/main.qml:198
msgid "Hotspot name cannot be empty"
msgstr "热点名称不能为空"

#: plasmoid/contents/ui/main.qml:199
msgid "Hotspot name must be at most 32 characters"
msgstr "热点名称最长 32 个字符"

#: plasmoid/contents/ui/main.qml:201
msgid "Password must be 8-63 characters"
msgstr "密码长度需 8-63 位"
