[Unit]
Description=并发热点 hostapd（ap0 虚拟接口，与 Wi-Fi 客户端同信道并存）
After=NetworkManager.service
Wants=NetworkManager.service
# 重启预算：配置错误时不要无限重启刷日志（StartLimit* 属于 [Unit] 段）
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/sbin/kde-hotspot.sh
# 停止/失败后清理：恢复 Wi-Fi 频段偏好、拆掉 NAT/转发/策略路由、清回退标记
#（否则异常退出会把 Wi-Fi 永久钉在 2.4GHz，规则也会残留）
ExecStopPost=/usr/local/sbin/kde-hotspot-ctl cleanup
Restart=on-failure
RestartSec=8

# 加固：服务只需要网络管理能力，不碰家目录与 /usr
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BROADCAST CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL

[Install]
WantedBy=multi-user.target
