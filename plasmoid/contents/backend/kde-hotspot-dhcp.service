[Unit]
Description=并发热点 DHCP（dnsmasq on ap0）
After=kde-hotspot.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# 用 bind-dynamic：ap0 在热点启动时才由主服务创建，dnsmasq 不需要等它，
# 接口出现时自动开始服务 DHCP（这也是原先 ExecStartPre 死等 ap0 导致启动超时的修复）。
# 另外 bind-dynamic 只绑定各接口自己的地址（man dnsmasq），不会占通配 0.0.0.0:53，
# 因此与 systemd-resolved 的 127.0.0.53:53 不冲突，无需关闭 resolved 的 stub listener。
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/kde-hotspot/dnsmasq.conf --pid-file=
Restart=on-failure
RestartSec=5

# ---------- 加固 ----------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# dnsmasq 自己需要的能力都保留（都有实证，不是"保险起见"）：
#   CAP_NET_BIND_SERVICE  绑定 53/67（<1024）
#   CAP_NET_ADMIN/NET_RAW bind-dynamic 的 netlink 与 DHCP 的 AF_PACKET 原始套接字
#   CAP_SETUID/SETGID     dnsmasq 会把自己降权到 nobody（二进制里有 setuid/setgid 路径）
#   CAP_DAC_OVERRIDE/CHOWN  打开/写租约与 PID 文件；二进制里的报错原文就是
#                         "chown of PID file %s failed: please add capability CAP_CHOWN"
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_CHOWN CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
