# 并发热点配置示例
# 安装后请复制为 /etc/kde-hotspot/config 并改成你自己的：
#   sudo install -m 644 config.example /etc/kde-hotspot/config
STA_IF=wlp0s20f3     # 上行 Wi-Fi 接口（用 iw dev 查看）
AP_IF=ap0            # 虚拟热点接口名
AP_IP=10.233.33.1    # 热点网关
AP_NET=10.233.33.0/24
SSID=my-hotspot      # 热点名称（改成你的）
PASS=change-me-12345 # 热点密码 8-63 字符（改成你的）
MODE=concurrent      # concurrent=并发模式(保持 Wi-Fi) / normal=普通模式(断开 Wi-Fi)
# FALLBACK_2G=yes    # 并发模式：固件拒绝 5GHz 时自动把 Wi-Fi 降到 2.4GHz 起热点
                     # （关闭热点时恢复频段偏好；设为 no 则不降频、热点保持关闭）
# RULE_PRIO=8990     # 热点网段策略路由优先级（需高于代理软件 TUN 的 9000 段，
                     # 让客户端流量绕过代理直连上行；一般不用改）
