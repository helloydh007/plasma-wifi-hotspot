#!/bin/bash
# 热点控制入口（以 root 运行；由插件通过 pkexec 免密码调用，
# polkit 动作带 exec.path 注解，授权只能执行本脚本）
#
# 用法:
#   kde-hotspot-ctl on            按当前模式开启热点
#   kde-hotspot-ctl off           关闭热点
#   kde-hotspot-ctl mode M        切换模式: concurrent | normal
#   kde-hotspot-ctl autostart on|off
#   kde-hotspot-ctl status --json 输出状态 JSON（只读）
#
# 两种模式:
#   concurrent  并发模式: hostapd + 虚拟 ap0，Wi-Fi 客户端保持连接（受限于同信道）
#   normal      普通模式: NetworkManager 原生热点，同一网卡切 AP，Wi-Fi 客户端必须断开
set -u
# 状态/备份文件一律收紧（band.backup 等虽无密码，保持一致的最小权限）
umask 077

CONF=/etc/kde-hotspot/config
STATE=/var/lib/kde-hotspot
DISABLED="$STATE/disabled"
BANDBACKUP="$STATE/band.backup"
CONNBACKUP="$STATE/band.conn"
STABACKUP="$STATE/sta-conn.backup"
NM_AP_CON=kde-hotspot-normal
UNIT_MAIN=kde-hotspot.service
UNIT_DHCP=kde-hotspot-dhcp.service
UNIT_NORMAL=kde-hotspot-normal.service

IW=/usr/sbin/iw
NMCLI=/usr/bin/nmcli
IPT=/usr/sbin/iptables

# ---------- 读配置 ----------
CONF_READABLE=no
if [ -r "$CONF" ]; then CONF_READABLE=yes; . "$CONF"; fi
AP_IF=${AP_IF:-ap0}
AP_IP=${AP_IP:-10.233.33.1}
AP_NET=${AP_NET:-10.233.33.0/24}
SSID=${SSID:-}
PASS=${PASS:-}
MODE=${MODE:-concurrent}
COUNTRY=${COUNTRY:-}
NORMAL_CHANNEL=${NORMAL_CHANNEL:-6}
DHCP_START=${DHCP_START:-50}
DHCP_END=${DHCP_END:-150}
DHCP_DNS=${DHCP_DNS:-223.5.5.5,119.29.29.29}

# STA_IF：留空或接口不存在时自动探测（第一个非 AP 的无线接口），
# 避免"接口名写错 → 永远待命且毫无提示"。
STA_IF=${STA_IF:-}
sta_if_auto=no
if [ -z "$STA_IF" ] || ! $IW dev "$STA_IF" info >/dev/null 2>&1; then
    _detected=$($IW dev 2>/dev/null | awk '/Interface/{print $2}' | grep -vx "$AP_IF" | head -1)
    if [ -n "${_detected:-}" ]; then
        if [ -n "$STA_IF" ]; then
            echo "[ctl] 配置的接口 $STA_IF 不存在，自动改用 $_detected" >&2
        fi
        STA_IF=$_detected
        sta_if_auto=yes
    elif [ -z "$STA_IF" ]; then
        STA_IF=wlan0
    fi
fi

log(){ echo "[ctl] $*" >&2; }
mkdir -p "$STATE" 2>/dev/null || true   # 免特权调用 status 时可能无权创建，忽略

# ---------- 权限辅助 ----------
# 无敏感信息的状态标记（disabled/fallback）做成可读，
# 这样插件可以免特权（不 fork root/不建 polkit 会话）轮询 status。
touch_public(){ : > "$1" 2>/dev/null || true; chmod 0644 "$1" 2>/dev/null || true; }

# 配置含热点密码：root 属主 + 640，读取权限授予网络管理组
#（组名由 deploy.sh 写入 $STATE/conf.group，一般为 netdev）。
# 这与 polkit 规则授权的用户集合一致，因此不降低安全等级。
fix_conf_perm(){
    local g=""
    [ -r "$STATE/conf.group" ] && g=$(cat "$STATE/conf.group" 2>/dev/null)
    [ -n "${g:-}" ] && chgrp "$g" "$CONF" 2>/dev/null || true
    chmod 0640 "$CONF" 2>/dev/null || true
}

# ---------- 凭据有效性 ----------
# 拒绝空值和 config.example 里的示例占位值：deploy.sh 会自动生成随机密码，
# 但手工复制示例、或用户清空字段时必须明确拒绝，而不是拿一个公开已知的
# 密码起热点。输出的第一行即"原因"。
cred_problem(){
    case "${SSID:-}" in
        "") echo "热点名称未设置" ;;
        my-hotspot|your-ssid*|change-me*|changeme*|example*) echo "热点名称仍是示例占位值（${SSID}）" ;;
    esac
    case "${PASS:-}" in
        "") echo "热点密码未设置" ;;
        change-me*|changeme*|your-password*|example*) echo "热点密码仍是示例占位值" ;;
    esac
    if [ -n "${SSID:-}" ] && [ "${#SSID}" -gt 32 ]; then echo "热点名称最长 32 个字符"; fi
    if [ -n "${PASS:-}" ] && { [ "${#PASS}" -lt 8 ] || [ "${#PASS}" -gt 63 ]; }; then
        echo "热点密码长度需 8-63 位"
    fi
}
cred_ok(){ [ -z "$(cred_problem | head -1)" ]; }

# ---------- 规则的拆除 ----------
# ensure_rules（监督脚本）会加 NAT + 两条 FORWARD 放行 + 策略路由；
# 关闭热点/切模式/停服务/卸载时都要拆掉，否则规则会留在系统里
#（装了 iptables-persistent 时甚至跨重启残留）。
remove_rules(){
    local n
    n=0; while $IPT -t nat -C POSTROUTING -s "$AP_NET" -o "$STA_IF" -j MASQUERADE 2>/dev/null; do
        $IPT -t nat -D POSTROUTING -s "$AP_NET" -o "$STA_IF" -j MASQUERADE 2>/dev/null || break
        n=$((n+1)); [ "$n" -gt 5 ] && break
    done
    n=0; while $IPT -C FORWARD -i "$AP_IF" -o "$STA_IF" -j ACCEPT 2>/dev/null; do
        $IPT -D FORWARD -i "$AP_IF" -o "$STA_IF" -j ACCEPT 2>/dev/null || break
        n=$((n+1)); [ "$n" -gt 5 ] && break
    done
    n=0; while $IPT -C FORWARD -i "$STA_IF" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; do
        $IPT -D FORWARD -i "$STA_IF" -o "$AP_IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || break
        n=$((n+1)); [ "$n" -gt 5 ] && break
    done
    ip rule del from "$AP_NET" lookup main >/dev/null 2>&1 || true
}

# ---------- 只读探测 ----------
iface_type(){ $IW dev "$STA_IF" info 2>/dev/null | awk '/type/{print $2; exit}'; }
iface_channel(){ $IW dev "$STA_IF" info 2>/dev/null | awk '/channel/{print $2; exit}'; }
sta_conn(){
    $NMCLI -t -f NAME,TYPE,DEVICE connection show --active 2>/dev/null \
        | awk -F: -v d="$STA_IF" '$2=="802-11-wireless" && $3==d {print $1; exit}'
}
ap0_channel(){ $IW dev "$AP_IF" info 2>/dev/null | awk '/channel/{print $2; exit}'; }
normal_running(){
    $NMCLI -t -f NAME,DEVICE connection show --active 2>/dev/null | grep -q "^$NM_AP_CON:" && echo yes || echo no
}
concurrent_running(){ systemctl is-active --quiet "$UNIT_MAIN" 2>/dev/null && echo yes || echo no; }
autostart_state(){
    if [ "$MODE" = normal ]; then
        systemctl is-enabled --quiet "$UNIT_NORMAL" 2>/dev/null && echo on || echo off
    else
        systemctl is-enabled --quiet "$UNIT_MAIN" 2>/dev/null && echo on || echo off
    fi
}

# ---------- 两套机制的拆除（互斥保证） ----------
stop_concurrent(){
    systemctl stop "$UNIT_MAIN" "$UNIT_DHCP" >/dev/null 2>&1 || true
    ip link set "$AP_IF" down >/dev/null 2>&1 || true
    $IW dev "$AP_IF" del >/dev/null 2>&1 || true
    remove_rules
}
stop_normal(){
    if $NMCLI -t -f NAME connection show 2>/dev/null | grep -qx "$NM_AP_CON"; then
        $NMCLI connection down "$NM_AP_CON" >/dev/null 2>&1 || true
        $NMCLI connection delete "$NM_AP_CON" >/dev/null 2>&1 || true
    fi
}

# ---------- 频段偏好恢复（并发模式）----------
# 备份（band.backup/band.conn）由监督脚本在"5GHz 被固件拒绝、自动降 2.4G"时写入；
# ctl 不再主动改 STA 频段，只在关闭热点时按备份恢复。
restore_band(){
    [ -e "$BANDBACKUP" ] || return 0
    local c v
    # 优先用备份时记录的连接名；恢复时 Wi-Fi 可能恰好断了
    c=$(cat "$CONNBACKUP" 2>/dev/null)
    [ -n "${c:-}" ] || c=$(sta_conn)
    v=$(cat "$BANDBACKUP" 2>/dev/null)
    rm -f "$BANDBACKUP" "$CONNBACKUP"
    if [ -n "${c:-}" ]; then
        $NMCLI connection modify "$c" 802-11-wireless.band "$v" >/dev/null 2>&1 || true
        $NMCLI connection up "$c" >/dev/null 2>&1 || true
        log "已恢复 '$c' 的频段偏好（${v:-自动}）"
    else
        log "频段备份已清理（找不到原连接 '$c'，无法恢复）"
    fi
}

# ---------- DHCP/DNS 配置渲染 ----------
# dnsmasq 的 interface / dhcp-range / 网关全部由 config 推导，避免用户改了
# AP_IF/AP_IP/AP_NET 之后 dnsmasq 静默失效（旧版把这三项写死在 dnsmasq.conf）。
sync_dnsmasq(){
    local dnsf=/etc/kde-hotspot/dnsmasq.conf
    local pre; pre=$(printf '%s' "$AP_IP" | cut -d. -f1-3)
    [ -n "${pre:-}" ] || pre=10.233.33
    local tmp; tmp=$(mktemp) || return 1
    {
        printf '# 由 kde-hotspot-ctl 依据 /etc/kde-hotspot/config 生成；请勿手动编辑\n'
        printf 'interface=%s\n' "$AP_IF"
        printf 'bind-dynamic\n'
        printf 'dhcp-range=%s.%s,%s.%s,255.255.255.0,12h\n' "$pre" "$DHCP_START" "$pre" "$DHCP_END"
        printf 'dhcp-option=3,%s\n' "$AP_IP"
        printf 'dhcp-option=6,%s\n' "$DHCP_DNS"
    } > "$tmp"
    if ! cmp -s "$tmp" "$dnsf" 2>/dev/null; then
        install -m 644 -o root -g root "$tmp" "$dnsf"
        log "已按 config 重新生成 $dnsf（接口 $AP_IF / 网关 $AP_IP / DNS $DHCP_DNS）"
        systemctl try-restart "$UNIT_DHCP" >/dev/null 2>&1 || true
    fi
    rm -f "$tmp"
}

# ---------- 清理（停服务后由 ExecStopPost 调用）----------
# 恢复 Wi-Fi 频段偏好、拆掉 NAT/转发/策略路由、清掉回退标记。
# 不做停止动作（此时服务已经在停），因此可安全地被 ExecStopPost 调用。
do_cleanup(){
    restore_band
    remove_rules
    rm -f "$STATE/fallback"
    log "已清理：Wi-Fi 频段偏好、NAT/转发规则、回退标记"
}

# ---------- on / off ----------
do_on(){
    if ! cred_ok; then
        local why; why=$(cred_problem | head -1)
        log "错误：$why（请编辑 /etc/kde-hotspot/config）"
        result false "$why（请编辑 /etc/kde-hotspot/config）"
        return 1
    fi
    rm -f "$DISABLED"
    case "$MODE" in
      normal)
        stop_concurrent
        local c; c=$(sta_conn)
        if [ -n "${c:-}" ]; then
            echo "$c" > "$STABACKUP"
            $NMCLI connection down "$c" >/dev/null 2>&1 || true
            log "已断开 Wi-Fi 客户端连接 '$c'（普通模式必须）"
        fi
        if ! $NMCLI -t -f NAME connection show 2>/dev/null | grep -qx "$NM_AP_CON"; then
            $NMCLI connection add type wifi ifname "$STA_IF" con-name "$NM_AP_CON" autoconnect no \
                802-11-wireless.mode ap \
                802-11-wireless.band bg \
                802-11-wireless.channel "$NORMAL_CHANNEL" \
                802-11-wireless.ssid "$SSID" \
                802-11-wireless-security.key-mgmt wpa-psk \
                802-11-wireless-security.psk "$PASS" \
                ipv4.method shared >/dev/null 2>&1 || { log "创建热点 profile 失败"; result false "创建热点 profile 失败"; return 1; }
            log "已创建普通模式热点 profile（ch$NORMAL_CHANNEL, shared）"
        fi
        $NMCLI connection up "$NM_AP_CON" >/dev/null 2>&1 || { log "激活普通模式热点失败"; result false "激活普通模式热点失败"; return 1; }
        log "普通模式热点已开启（SSID=$SSID）"
        result true "普通模式热点已开启（$SSID）"
        ;;
      *)
        stop_normal
        sync_dnsmasq
        systemctl start "$UNIT_MAIN" "$UNIT_DHCP" >/dev/null 2>&1 || true
        sleep 1
        if ! systemctl is-active --quiet "$UNIT_MAIN"; then
            log "并发模式服务启动失败，见 journalctl -u kde-hotspot"
            result false "服务启动失败，见 journalctl -u kde-hotspot"
            return 1
        fi
        log "并发模式已开启（热点跟随 Wi-Fi 当前信道；固件不支持 5G 时自动回退 2.4GHz）"
        # 措辞如实：此时只是指令已下发，hostapd 尚未发信标
        result true "开启指令已下发，热点正在启动（将跟随 Wi-Fi 信道发信标）"
        ;;
    esac
}

do_off(){
    case "$MODE" in
      normal)
        stop_normal
        if [ -s "$STABACKUP" ]; then
            local c; c=$(cat "$STABACKUP")
            $NMCLI connection up "$c" >/dev/null 2>&1 || true
            rm -f "$STABACKUP"
            log "已恢复 Wi-Fi 连接 '$c'"
        fi
        log "普通模式热点已关闭"
        result true "普通模式热点已关闭，Wi-Fi 已恢复"
        ;;
      *)
        touch_public "$DISABLED"
        stop_concurrent
        restore_band
        rm -f "$STATE/fallback"
        log "并发模式热点已关闭（保持关闭，直到重新开启）"
        result true "热点已关闭，并保持关闭（Wi-Fi 频段偏好已恢复）"
        ;;
    esac
}

do_mode(){
    local m="${1:-}"
    case "$m" in concurrent|normal) ;; *) log "模式必须是 concurrent 或 normal"; return 2;; esac
    # 切换模式时先停两套、并临时置 disabled 防止服务自己又起来
    touch_public "$DISABLED"
    stop_normal
    stop_concurrent
    if grep -q '^MODE=' "$CONF" 2>/dev/null; then
        sed -i "s/^MODE=.*/MODE=$m/" "$CONF"
    else
        printf '\nMODE=%s\n' "$m" >> "$CONF"
    fi
    fix_conf_perm
    MODE="$m"
    # 模式切换后自启统一关闭（普通模式自启会在开机时断开 Wi-Fi，必须用户显式开启）
    rm -f "$STATE/autostart-normal"
    rm -f "$STATE/fallback"
    systemctl disable "$UNIT_NORMAL" >/dev/null 2>&1 || true
    log "已切换到 $m 模式；两套热点机制都已停止，需要时再手动开启；自启已关闭，需要的话请重新打开"
    result true "已切换到${m}模式；热点已停止；自启已关闭（需重新打开）"
}

do_autostart(){
    case "${1:-}" in on|off) ;; *) log "用法: autostart on|off"; return 2;; esac
    if [ "$1" = on ]; then
        if [ "$MODE" = normal ]; then
            systemctl disable "$UNIT_MAIN" "$UNIT_DHCP" >/dev/null 2>&1 || true
            touch "$STATE/autostart-normal"
            systemctl enable "$UNIT_NORMAL" >/dev/null 2>&1 || true
        else
            rm -f "$STATE/autostart-normal"
            systemctl disable "$UNIT_NORMAL" >/dev/null 2>&1 || true
            systemctl enable "$UNIT_MAIN" "$UNIT_DHCP" >/dev/null 2>&1 || true
        fi
        log "已启用开机自启（$MODE 模式）"
        result true "已启用开机自启（$MODE 模式）"
    else
        rm -f "$STATE/autostart-normal"
        systemctl disable "$UNIT_MAIN" "$UNIT_DHCP" "$UNIT_NORMAL" >/dev/null 2>&1 || true
        log "已关闭开机自启"
        result true "已关闭开机自启"
    fi
}

# ---------- 修改热点名称/密码 ----------
set_credentials(){
    local ssid="" pass="" pf=""
    # 解析：set-credentials SSID [PASS|-] [--pass-file FILE]
    # PASS 为 "-" 时从 stdin 读；--pass-file 从 600 文件读后删除（避免密码进 argv）
    while [ "$#" -gt 0 ]; do
        case "${1:-}" in
            --pass-file)
                shift
                pf="${1:-}"
                [ "$#" -gt 0 ] && shift
                ;;
            *)
                if [ -z "$ssid" ]; then ssid="$1"
                elif [ -z "$pass" ]; then pass="$1"
                fi
                shift
                ;;
        esac
    done
    if [ -n "$pf" ]; then
        pass=$(cat "$pf" 2>/dev/null || true)
        rm -f "$pf" 2>/dev/null || true
    elif [ "$pass" = "-" ]; then
        IFS= read -r pass || pass=""
    fi
    case "$ssid" in *$'\n'*) log "SSID 不能含换行"; result false "SSID 不能含换行"; return 1;; esac
    case "$pass" in *$'\n'*) log "密码不能含换行"; result false "密码不能含换行"; return 1;; esac
    [ -n "$ssid" ] || { log "SSID 不能为空"; result false "SSID 不能为空"; return 1; }
    [ "${#ssid}" -le 32 ] || { log "SSID 最长 32 个字符"; result false "SSID 最长 32 个字符"; return 1; }
    case "$ssid" in
        my-hotspot|your-ssid*|change-me*|changeme*|example*)
            log "拒绝把名称设为示例占位值：$ssid"; result false "请换一个热点名称（不能是示例占位值）"; return 1 ;;
    esac
    if [ -n "$pass" ]; then
        if [ "${#pass}" -lt 8 ] || [ "${#pass}" -gt 63 ]; then
            log "密码长度需 8-63 位"; result false "密码长度需 8-63 位"; return 1
        fi
        case "$pass" in
            change-me*|changeme*|your-password*|example*)
                log "拒绝把密码设为示例占位值"; result false "请换一个密码（不能是示例占位值）"; return 1 ;;
        esac
    fi
    local tmp; tmp=$(mktemp) || { result false "无法创建临时文件"; return 1; }
    cp -a "$CONF" "$tmp" 2>/dev/null || true
    # 用 awk 重写整行；值经环境变量传入（-v 会解释反斜杠转义，密码含 \ 时会被改写）
    ZK_SSID="$ssid" ZK_PASS="$pass" awk '
        /^SSID=/ { print "SSID=" ENVIRON["ZK_SSID"]; done_ssid=1; next }
        /^PASS=/ {
            # 密码留空表示"只改名称"，此时必须保留原有 PASS 行；
            # 旧实现直接跳过该行 → 会把密码从配置里删掉
            if (ENVIRON["ZK_PASS"] != "") print "PASS=" ENVIRON["ZK_PASS"]; else print
            done_pass=1; next
        }
        { print }
        END {
            if (!done_ssid) print "SSID=" ENVIRON["ZK_SSID"]
            if (ENVIRON["ZK_PASS"] != "" && !done_pass) print "PASS=" ENVIRON["ZK_PASS"]
        }' "$CONF" > "$tmp" 2>/dev/null || { rm -f "$tmp"; result false "写入配置失败"; return 1; }
    install -m 640 -o root -g root "$tmp" "$CONF"
    rm -f "$tmp"
    fix_conf_perm
    SSID="$ssid"; [ -n "$pass" ] && PASS="$pass"
    log "已更新配置：SSID=$ssid$([ -n "$pass" ] && echo "，密码已更新")"

    # 若某个机制正在运行，重启让新配置生效
    if [ "$MODE" = normal ] && [ "$(normal_running)" = yes ]; then
        stop_normal
        do_on >/dev/null 2>&1 || true
        log "已按新配置重启普通模式热点"
        result true "已保存并重启热点：SSID=$ssid"
    elif [ "$(concurrent_running)" = yes ] && [ -n "$(ap0_channel)" ]; then
        systemctl restart "$UNIT_MAIN" "$UNIT_DHCP" >/dev/null 2>&1 || true
        log "已按新配置重启并发模式热点（数秒后重新发信标）"
        result true "已保存并重启热点：SSID=$ssid"
    else
        log "热点当前未运行；新配置将在下次开启时生效"
        result true "已保存：SSID=$ssid（热点未运行，下次开启时生效）"
    fi
}

# ---------- JSON 状态 ----------
jstr(){ printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# 动作类命令向 stdout 输出一行 JSON 结果（人类可读日志仍走 stderr），
# 插件据此判断成败——不再依赖 exitCode 的类型（executable 引擎里可能是字符串）
result(){ printf '{"ok":%s,"message":"%s"}\n' "$1" "$(jstr "$2")"; }

do_status(){
    local it ch freq ssid band conn=no hot=no hch="" hband="" mech=none gw=""
    it=$(iface_type); ch=$(iface_channel)
    ssid=$($IW dev "$STA_IF" info 2>/dev/null | awk '/ssid/{print $2; exit}')
    freq=$($IW dev "$STA_IF" info 2>/dev/null | grep -oE '\([0-9]+ MHz\)' | tr -dc '0-9')

    if [ "$it" = "AP" ]; then
        # 普通模式：同一网卡就是 AP，没有客户端连接信息
        conn=no; band=""
    else
        if [ -n "${ch:-}" ]; then
            conn=yes
            if [ "$ch" -le 14 ] 2>/dev/null; then band=2.4G; else band=5G; fi
        fi
    fi

    if [ "$MODE" = normal ]; then
        if [ "$(normal_running)" = yes ]; then
            hot=yes; mech=nm; hch=$ch; [ -n "${ch:-}" ] && { if [ "$ch" -le 14 ] 2>/dev/null; then hband=2.4G; else hband=5G; fi; }
        fi
    else
        if [ -n "$(ap0_channel)" ]; then
            hot=yes; mech=hostapd; hch=$(ap0_channel); gw="$AP_IP"
            # 频段按 ap0 实际信道推导：5GHz 并发热点（固件支持时）就该显示 5G，
            # 否则面板会出现"2.4G ch44"这种自相矛盾的显示
            if [ "${hch:-0}" -le 14 ] 2>/dev/null; then hband=2.4G; else hband=5G; fi
        elif [ "$(concurrent_running)" = yes ]; then
            mech=hostapd
        fi
    fi

    local disabled=false; [ -e "$DISABLED" ] && disabled=true
    local fb=false; [ -e "$STATE/fallback" ] && fb=true
    local iface_present=yes; $IW dev "$STA_IF" info >/dev/null 2>&1 || iface_present=no
    local clients=0
    if [ -r /var/lib/misc/dnsmasq.leases ]; then
        clients=$(grep -c . /var/lib/misc/dnsmasq.leases 2>/dev/null || true)
        clients=${clients:-0}
    fi

    printf '{\n'
    printf '  "mode": "%s",\n' "$MODE"
    printf '  "disabled": %s,\n' "$disabled"
    printf '  "autostart": "%s",\n' "$(autostart_state)"
    # 配置不可读（用户不在授权组）时，mode/SSID/PASS 都是默认值/空值，
    # 插件据此提示"读到的是默认值"，而不是把默认值当成真实状态
    printf '  "config_readable": %s,\n' "$([ "$CONF_READABLE" = yes ] && echo true || echo false)"
    printf '  "sta_if_auto": %s,\n' "$([ "$sta_if_auto" = yes ] && echo true || echo false)"
    printf '  "wifi": {"iface": "%s", "present": "%s", "type": "%s", "connected": "%s", "ssid": "%s", "channel": "%s", "freq": "%s", "band": "%s"},\n' \
        "$STA_IF" "$iface_present" "$(jstr "${it:-}")" "$conn" "$(jstr "${ssid:-}")" "${ch:-}" "${freq:-}" "${band:-}"
    printf '  "hotspot": {"running": "%s", "mechanism": "%s", "ssid": "%s", "pass": "%s", "channel": "%s", "band": "%s", "gateway": "%s", "clients": %s, "fallback": %s},\n' \
        "$hot" "$mech" "$(jstr "$SSID")" "$(jstr "$PASS")" "${hch:-}" "${hband:-}" "${gw:-}" "$clients" "$fb"
    printf '  "concurrent_service_active": "%s",\n' "$(concurrent_running)"
    printf '  "normal_service_active": "%s"\n' "$(normal_running)"
    printf '}\n'
}

# ---------- 入口 ----------
case "${1:-}" in
  on)        do_on ;;
  off)       do_off ;;
  mode)      do_mode "${2:-}" ;;
  autostart) do_autostart "${2:-}" ;;
  set-credentials) shift; set_credentials "$@" ;;
  cleanup)   do_cleanup ;;
  sync-helpers) sync_dnsmasq ;;
  status)    do_status ;;
  *) cat >&2 <<EOF
用法: kde-hotspot-ctl <命令>
  on                     按当前模式开启热点
  off                    关闭热点
  mode concurrent|normal 切换模式（会先停掉两套机制）
  autostart on|off       开机自启
  set-credentials SSID [PASS]   改热点名称/密码
        PASS 省略=只改名称；PASS 为 - =从 stdin 读；--pass-file FILE =从文件读后删除
  cleanup                清理残留（恢复频段偏好、拆除 NAT/转发规则、清回退标记）
  sync-helpers           按 config 重新生成 dnsmasq.conf
  status --json          状态 JSON
EOF
     exit 2 ;;
esac
